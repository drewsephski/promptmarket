  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
